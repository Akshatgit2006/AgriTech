# Copy this file to .env and configure your production values.
# Never commit the .env file containing real secrets to version control.

# MongoDB Connection
# Set your MongoDB Atlas connection string (or self-hosted replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/
MONGODB_DB=fieldwise

# Security & Authentication
# Generate a secure random string of at least 32 characters (e.g. via `openssl rand -base64 32`)
JWT_SECRET=your-32-plus-character-secret-key-goes-here

# Storage Mode
# MUST be false in production and on Vercel (uses MongoDB Atlas)
DEMO_MODE=false

# Server Port (optional, defaults to 3001)
PORT=3001

# Seed Administrator Account (only used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=YourStrongPassword123!
