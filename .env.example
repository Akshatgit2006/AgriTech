# Copy this file to .env and configure your production values.
# Never commit the .env file containing real secrets to version control.

# MongoDB Connection
# Set your MongoDB Atlas connection string
MONGODB_URI=
MONGODB_DB=fieldwise

# Security & Authentication
# Generate a secure random string of at least 32 characters (e.g. via `openssl rand -base64 32`)
JWT_SECRET=

# Server Port (optional, defaults to 3001)
PORT=3001

# One-time administrator setup (set locally before npm run create-admin, then remove)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional: seed farm, crop, soil, and activity examples for an existing farmer
# SEED_OWNER_EMAIL=
